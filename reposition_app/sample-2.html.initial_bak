      }

      function formatSipLocation(format, data) {
        var d = data || {};
        var out = (format || "")
          .replace(/\{city\}/g, d.city || "")
          .replace(/\{region\}/g, d.region || "")
          .replace(/\{country_code\}/g, d.country_code || "")
          .replace(/\{country\}/g, d.country || "");
        out = out
          .replace(/\s*,(?:\s*,)+/g, ", ")
          .replace(/^[\s,]+|[\s,]+$/g, "")
          .replace(/\s{2,}/g, " ");
        return out.trim();
      }

      function HplFormatDateTemplate(template, date, locale, orientation, formatDate, device, location) {
        const place = location || {};
        const source = String(template ?? "");
        const hasLocation = /\{(?:city|region|country|country_code)\}/.test(source);
        let output = source.replace(/\{([^{}]*)\}/g, (match, token) => {
          if (token === "device") return device;
          if (["city", "region", "country", "country_code"].includes(token)) return place[token] || "";
          if (token === "br") return "\n";
          if (token === "pbr") return orientation === "portrait" ? "\n" : "";
          if (token === "lbr") return orientation === "landscape" ? "\n" : "";
          const remainder = token.replace(/dddd|ddd|YYYY|YY|MMMM|MMM|MM|M|DD|Do|D|HH|H|hh|h|mm|m|ss|s|A|a/g, "");
          return /[A-Za-z]/.test(remainder) ? match : formatDate(token, date, locale);
        });
        if (hasLocation) output = output.replace(/\s*,(?:\s*,)+/g, ", ").replace(/^[\s,]+|[\s,]+$/g, "").replace(/\s{2,}/g, " ").trim();
        return output;
      }
      // --- Month-text helpers (shared by custom text overlays) ---

      var SIP_MONTH_KEYS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];

      function resolveSipMonthText(monthTexts, date) {
        var m = monthTexts || {};
        var key = SIP_MONTH_KEYS[date.getMonth()];
        return m[key] || m.default || "";
      }


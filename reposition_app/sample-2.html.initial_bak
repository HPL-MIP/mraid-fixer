      function resolveSipCustomTextLineBreaks(value, orientation) {
        return String(value || "")
          .split("{pbr}").join(orientation === "portrait" ? "\n" : "")
          .split("{lbr}").join(orientation === "landscape" ? "\n" : "")
          .split("{br}").join("\n")
          .split("[br-p]").join(orientation === "portrait" ? "\n" : "")

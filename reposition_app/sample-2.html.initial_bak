<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SIP Template [HPL]</title>
  <script src="mraid.js"></script>
  <script>
    // MRAID v2.0 readiness guard. Keep this immediately after the bridge
    // declaration so every later MRAID call can use the same state check.
    (function () {
      let mraidIsReady = false;
      let mraidReadyListenerAttached = false;

      function trackMraidReadiness(mraid) {
        if (
          mraidReadyListenerAttached ||
          !mraid ||
          typeof mraid.addEventListener !== "function"
        ) {
          return;
        }

        try {
          mraid.addEventListener("ready", () => {
            mraidIsReady = true;
          });
          mraidReadyListenerAttached = true;
        } catch (_error) {
          // Non-standard preview bridges may throw here. getState() remains
          // the primary readiness signal in compliant MRAID containers.
        }
      }

      window.isMraidUsable = function (mraid) {
        if (!mraid) {
          return false;
        }

        trackMraidReadiness(mraid);

        // Minimal preview mocks sometimes omit getState().
        if (typeof mraid.getState !== "function") {
          return true;
        }

        try {
          const state = mraid.getState();
          return state === "default" || state === "expanded";
        } catch (_error) {
          return mraidIsReady;
        }
      };
    })();
  </script>
  <style>
    @font-face {
      font-family: "SipCountdownFont";
      font-weight: 100 900;
      font-style: normal;
      src: url(data:application/octet-stream;base64,) format("truetype");
    }



    @media (orientation: portrait) {
      body {
        background: linear-gradient(to bottom, #c8bcad 0%, #c8bcad 50%, #462517 50%, #462517 100%);
      }
    }

    @media (orientation: landscape) {
      body {
        background: linear-gradient(to right, #9a6d50 0%, #9a6d50 50%, #ffffff 50%, #ffffff 100%);
      }
    }

    #video-container {
      position: relative;
      overflow: hidden;
    }

    #video-container>video {
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    #sip-date {
      position: absolute;
      left: 0;
      top: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      white-space: pre;
      pointer-events: none;
      z-index: 2;
      transform-origin: center center;
      box-sizing: content-box;
    }

    @media (orientation: portrait) {
      #sip-date {
        color: #000000;
        font-weight: 700;
        font-style: normal;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-align: center;

        background-color: transparent;
        padding: 0;
        border-radius: 0;
        border: none;
        box-shadow: none;
      }
    }

    @media (orientation: landscape) {
      #sip-date {
        color: #000000;
        font-weight: 700;
        font-style: normal;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-align: center;

        background-color: transparent;
        padding: 0;
        border-radius: 0;
        border: none;
        box-shadow: none;
      }
    }


    #sip-countdown {
      position: absolute;
      left: 0;
      top: 0;
      font-family: "SipCountdownFont", sans-serif;
      font-variant-numeric: tabular-nums;
      font-feature-settings: "tnum";
      white-space: pre;
      pointer-events: none;
      z-index: 3;
      display: inline-flex;
      align-items: flex-start;
      justify-content: center;
    }

    #sip-countdown .sip-countdown-unit {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      text-align: center;
    }

    #sip-countdown .sip-countdown-digits {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1.1;
    }

    #sip-countdown .sip-countdown-digit {
      display: inline-block;
      width: 1ch;
      text-align: center;
    }

    #sip-countdown .sip-countdown-sep {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1.1;
      padding: 0 0.55ch;
    }

    #sip-countdown .sip-countdown-label {
      display: block;
      font-family: "SipDynamicFont1", sans-serif;
      font-size: 0.38em;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 0;
      color: #000000;
      margin-top: 0.22em;
      text-align: center;
    }

    @media (orientation: portrait) {
      #sip-countdown {
        color: #000000;
        font-weight: 700;
        font-style: normal;
        text-decoration: none;
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-align: center;
      }
    }

    @media (orientation: landscape) {
      #sip-countdown {
        color: #000000;
        font-weight: 700;
        font-style: normal;
        text-decoration: none;
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-align: center;
      }
    }

    #sip-countdown .sip-countdown-digit {
      width: 1ch;
    }

    @media (orientation: landscape) {
      #sip-countdown .sip-countdown-digit {
        width: 1ch;
      }
    }
  </style>
  <!-- positions injected via JS: P(0.5,0.505) L(0.5,0.465) -->
  <script
    id="sip-preview-date-override-v1">(function () { var value = new URLSearchParams(window.location.search).get('date'), preview = null; if (value && /^\d{4}-\d{2}-\d{2}$/.test(value)) { var parts = value.split('-').map(Number), candidate = new Date(0); candidate.setFullYear(parts[0], parts[1] - 1, parts[2]); candidate.setHours(12, 0, 0, 0); if (candidate.getFullYear() === parts[0] && candidate.getMonth() === parts[1] - 1 && candidate.getDate() === parts[2]) preview = candidate; } window.__sipPreviewNow = function () { return preview ? new Date(preview.getTime()) : new Date(); }; })();</script>
  <style>
    @font-face {
      font-family: "SipDynamicFont1";
      font-weight: 100 900;
      src: url(data:application/octet-stream;base64,) format("truetype");
    }

    #sip-dynamic-dynamic-1 {
      position: absolute;
      left: 0;
      top: 0;
      white-space: pre;
      pointer-events: none;
      z-index: 2;
      transform-origin: center center;
      box-sizing: content-box;
      font-family: "SipDynamicFont1", sans-serif;
    }

    #sip-dynamic-dynamic-1 sup {
      font-size: .65em;
      vertical-align: super;
      line-height: 0;
    }

    @media (orientation: portrait) {
      #sip-dynamic-dynamic-1 {
        color: #000000;
        font-weight: 700;
        font-style: normal;
        text-decoration: none;
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-align: center;

        background-color: transparent;
        padding: 0;
        border-radius: 0;
        border: none;
        box-shadow: none;
      }
    }

    @media (orientation: landscape) {
      #sip-dynamic-dynamic-1 {
        color: #000000;
        font-weight: 700;
        font-style: normal;
        text-decoration: none;
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-align: center;

        background-color: transparent;
        padding: 0;
        border-radius: 0;
        border: none;
        box-shadow: none;
      }
    }

    @font-face {
      font-family: "SipDynamicFont2";
      font-weight: 100 900;
      src: url(data:application/octet-stream;base64,) format("truetype");
    }

    #sip-dynamic-dynamic-2 {
      position: absolute;
      left: 0;
      top: 0;
      white-space: pre;
      pointer-events: none;
      z-index: 2;
      transform-origin: center center;
      box-sizing: content-box;
      font-family: "SipDynamicFont2", sans-serif;
    }

    #sip-dynamic-dynamic-2 sup {
      font-size: .65em;
      vertical-align: super;
      line-height: 0;
    }

    @media (orientation: portrait) {
      #sip-dynamic-dynamic-2 {
        color: #000000;
        font-weight: 700;
        font-style: normal;
        text-decoration: none;
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-align: center;

        background-color: transparent;
        padding: 0;
        border-radius: 0;
        border: none;
        box-shadow: none;
      }
    }

    @media (orientation: landscape) {
      #sip-dynamic-dynamic-2 {
        color: #000000;
        font-weight: 700;
        font-style: normal;
        text-decoration: none;
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.2;
        text-align: center;

        background-color: transparent;
        padding: 0;
        border-radius: 0;
        border: none;
        box-shadow: none;
      }
    }
  </style>
</head>
<style>
  html,
  body {
    padding: 0;
    margin: 0;
    height: 100%;
    /* iOS Safari auto-inflates small text on absolutely-positioned overlays
         even with the viewport meta. That breaks overlay position math, which
         caches text width before inflation. Pin to 100% to opt out. */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    /* dvh tracks the *visible* viewport on iOS Safari, so it stays in sync
         with window.innerHeight regardless of URL-bar state. vh is kept as a
         fallback for browsers that don't support dvh. Without this, on long
         phones (e.g. iPhone Pro Max) in landscape, 100vh = URL-bar-collapsed
         height while innerHeight = URL-bar-expanded height; the orientation
         workaround sizes the container off the smaller value and CSS renders
         it at the larger one, throwing the overlay's cover-fit math off. */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #video-container {
    width: 100%;
    height: 100vh;
    height: 100dvh;
  }

  #video-container video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<body>
  <div id="video-container">
    <video id="sip-video" preload="none" autoplay muted loop playsinline>
      <source id="sip-video-source" src="" type="video/mp4" />
    </video>
    <div id="sip-dynamic-dynamic-1"></div>
    <div id="sip-dynamic-dynamic-2"></div>

    <div id="sip-countdown"></div>
  </div>
  <script>
    /*
     * SIP Video Template
     *
     * Behavior:
     * - Switches source by viewport orientation:
     *   portrait -> base64(portrait.mp4), landscape -> base64(landscape.mp4)
     * - Applies container size workaround for extreme aspect ratios.
     * - Uses requestAnimationFrame to coalesce resize/orientation events.
     * - Attaches heavy listeners only while page is visible.
     * - Defers all MRAID calls and layout decisions until MRAID is ready.
     */

    function startAdRuntime() {
      // --------------------------------------------------------------------------------------
      // Start Editing here
      // --------------------------------------------------------------------------------------
      // TODO: Add base64 video for portrait
      const srcPortrait = "data:video/mp4;base64,";
      // TODO: Add base64 video for landscape
      const srcLandscape = "data:video/mp4;base64,";
      // --------------------------------------------------------------------------------------
      // Stop Editing here
      // --------------------------------------------------------------------------------------

      // 16:9 is the target content frame used to compute fit workaround.
      const targetAspectRatio = 16 / 9;
      // Threshold for triggering extreme aspect-ratio compensation.
      const extremeRatioThreshold = 1.8;

      const video = document.getElementById("sip-video");
      const source = document.getElementById("sip-video-source");
      const container = document.getElementById("video-container");

      if (!video || !source || !container) {
        throw new Error("Required SIP video elements are unavailable.");
      }

      video.addEventListener("playing", () => signalPlayableLifecycle("gameStart"), {
        once: true,
      });
      video.addEventListener("ended", () => signalPlayableLifecycle("gameEnd"));

      // Handles clickthrough only after the MRAID bridge reaches an
      // interactive state. Browser previews log clicks without navigating.
      function handleClickAction() {
        const clickTarget =
          window.clickTag ||
          window.clickTag1 ||
          window.clickthrough ||
          window.clickThrough ||
          "";

        // Keep this canonical MRAID v2 click-through shape intact. Several
        // network validators scan the exported source instead of executing it,
        // so aliasing window.mraid or minifying this call can produce a false
        // "mraid present but no mraid.open()" rejection.
        if (
          typeof mraid !== "undefined" &&
          typeof mraid.open === "function" &&
          window.isMraidUsable(mraid)
        ) {
          try {
            if (clickTarget) {
              mraid.open(clickTarget);
            } else {
              mraid.open();
            }
            return;
          } catch (_error) { }
        }

        // Browser previews have no MRAID bridge and must not navigate.
        console.log("CTA_CLICKED");
      }

      let lastTapAt = 0;

      // Some iOS Safari environments do not consistently fire pointer events.
      function handleTap(event) {
        const now = Date.now();
        if (now - lastTapAt < 500) {
          return;
        }

        if (
          event &&
          (event.type === "touchend" ||
            event.type === "pointerup" ||
            event.type === "click")
        ) {
          lastTapAt = now;
        }

        handleClickAction();
      }

      // Writes size only when changed to avoid unnecessary style churn.
      function setContainerSize(widthPct, heightPct) {
        const width = `${widthPct}%`;
        const height = `${heightPct}%`;
        if (container.style.width !== width) {
          container.style.width = width;
        }
        if (container.style.height !== height) {
          container.style.height = height;
        }
      }

      // Returns the container to full-screen footprint.
      function resetContainer() {
        setContainerSize(100, 100);
      }

      // Applies source + sizing based on current viewport orientation and ratio.
      function setVideoForOrientation() {
        // matchMedia is wired to the CSS @media (orientation:) query, which
        // resolves from the actual device orientation. window.innerWidth/Height
        // can lag during orientation transitions on long iOS devices (e.g.
        // iPhone Pro Max), still reporting the previous orientation's dims for
        // several frames after the rotation completes.
        const isPortrait = window.matchMedia
          ? !window.matchMedia("(orientation: landscape)").matches
          : window.innerHeight > window.innerWidth;
        // Decouple width/height from which axis iOS happens to report on:
        // the device's long edge is the long edge regardless. Assign to
        // width/height by the orientation we trust (matchMedia), so even if
        // innerWidth/innerHeight are momentarily swapped, the workaround math
        // below operates on the correct axes and never produces a 385%-wide
        // container that corrupts subsequent rotations.
        const dimA = window.innerWidth;
        const dimB = window.innerHeight;
        const longSide = Math.max(dimA, dimB);
        const shortSide = Math.min(dimA, dimB);
        const width = isPortrait ? shortSide : longSide;
        const height = isPortrait ? longSide : shortSide;
        const src = isPortrait ? srcPortrait : srcLandscape;
        const normalizedRatio =
          width > height ? width / height : height / width;

        resetContainer();
        if (isPortrait) {
          if (normalizedRatio > extremeRatioThreshold) {
            const targetHeight = width * targetAspectRatio;
            setContainerSize(100, (targetHeight / height) * 100);
          }
        } else {
          if (normalizedRatio > extremeRatioThreshold) {
            const targetWidth = height * targetAspectRatio;
            setContainerSize((targetWidth / width) * 100, 100);
          }
        }

        if (source.getAttribute("src") !== src) {
          source.setAttribute("src", src);
          video.load();
        }
      }

      let listenersController = null;
      let pendingFrame = 0;

      // Schedules a single layout update per animation frame.
      function scheduleOrientationUpdate() {
        if (pendingFrame) {
          return;
        }

        pendingFrame = window.requestAnimationFrame(() => {
          pendingFrame = 0;
          setVideoForOrientation();
        });
      }

      // Subscribes runtime listeners only when page is active.
      function attachActiveListeners() {
        if (listenersController) {
          return;
        }

        listenersController = new AbortController();
        const { signal } = listenersController;

        window.addEventListener("resize", scheduleOrientationUpdate, {
          signal,
          passive: true,
        });
        window.addEventListener(
          "orientationchange",
          scheduleOrientationUpdate,
          {
            signal,
            passive: true,
          },
        );
        // iOS Safari does not always fire `resize` on the window when the URL
        // bar collapses/expands. visualViewport reliably does — so re-run the
        // orientation workaround so container size tracks the visible area.
        if (window.visualViewport) {
          window.visualViewport.addEventListener(
            "resize",
            scheduleOrientationUpdate,
            { signal, passive: true },
          );
        }
        // Some embedding environments (AppLovin's iframe preview) resize the
        // iframe on orientation change without dispatching window.resize
        // inside it. ResizeObserver on the document element fires for any
        // viewport size change regardless of how it was triggered.
        if (window.ResizeObserver) {
          const ro = new ResizeObserver(scheduleOrientationUpdate);
          ro.observe(document.documentElement);
          signal.addEventListener("abort", () => ro.disconnect());
        }
        document.addEventListener("pointerup", handleTap, { signal });
        document.addEventListener("touchend", handleTap, {
          signal,
          passive: true,
        });
        document.addEventListener("click", handleTap, { signal });
      }

      // Unsubscribes listeners and cancels pending work to reduce overhead.
      function detachActiveListeners() {
        if (!listenersController) {
          return;
        }

        listenersController.abort();
        listenersController = null;

        if (pendingFrame) {
          window.cancelAnimationFrame(pendingFrame);
          pendingFrame = 0;
        }
      }

      let mraidViewable = true;

      // Activity lifecycle: visible -> attach/resume, hidden -> detach/pause.
      function syncWindowActivityState() {
        const isActive =
          document.visibilityState === "visible" && mraidViewable;

        if (isActive) {
          attachActiveListeners();
          scheduleOrientationUpdate();
          video.play().catch(() => { });
        } else {
          detachActiveListeners();
          video.pause();
        }
      }

      // Visibility/focus hooks used to toggle active runtime behavior.
      document.addEventListener("visibilitychange", syncWindowActivityState);
      window.addEventListener("focus", syncWindowActivityState);
      window.addEventListener("blur", syncWindowActivityState);
      window.addEventListener("pagehide", syncWindowActivityState);

      // MRAID hosts can keep the document visible while the ad itself is not
      // viewable. Pause media and runtime listeners in that state as required
      // by the MRAID lifecycle.
      function setupMraidViewability() {
        const mraid =
          typeof window.mraid !== "undefined" ? window.mraid : null;
        if (!mraid) {
          return;
        }

        function handleViewableChange(viewable) {
          mraidViewable = Boolean(viewable);
          // Keep the standalone call near the end of this template unique;
          // buildExportHtml uses it as the overlay-runtime injection anchor.
          syncWindowActivityState.call(null);
        }

        function handleExposureChange(exposedPercentage) {
          if (typeof exposedPercentage !== "number") {
            return;
          }
          handleViewableChange(exposedPercentage > 0);
        }

        function handleAudioVolumeChange(volumePercentage) {
          // Some SDKs use null to mean "unknown". Never perform volume math
          // unless the bridge supplied a real number.
          if (volumePercentage === null || typeof volumePercentage !== "number") {
            return;
          }
          video.volume = Math.max(0, Math.min(1, volumePercentage / 100));
        }

        if (typeof mraid.isViewable === "function") {
          try {
            mraidViewable = Boolean(mraid.isViewable());
          } catch (_error) {
            mraidViewable = true;
          }
        }

        if (typeof mraid.addEventListener === "function") {
          try {
            mraid.addEventListener("error", (message, action) => {
              console.warn("[MRAID error]", message, action);
            });
            // MRAID 3.0 signal, followed by the MRAID 2.0 fallback above.
            mraid.addEventListener("exposureChange", handleExposureChange);
            mraid.addEventListener("viewableChange", handleViewableChange);
            mraid.addEventListener(
              "audioVolumeChange",
              handleAudioVolumeChange,
            );
          } catch (_error) {
            // Browser previews may expose an incomplete MRAID mock.
          }
        }
      }

      setupMraidViewability();
      // --- Overlay animation helpers (shared by date + countdown) ---

      function __sipEase(t, name) {
        if (t <= 0) return 0;
        if (t >= 1) return 1;
        switch (name) {
          case "linear": return t;
          case "ease-in": return t * t * t;
          case "ease-out": return 1 - Math.pow(1 - t, 3);
          case "ease-in-out":
            return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          case "ease":
          default: return 1 - Math.pow(1 - t, 2);
        }
      }
      function __sipOffset(dir, dist) {
        switch (dir) {
          case "top": return { x: 0, y: -dist };
          case "bottom": return { x: 0, y: dist };
          case "left": return { x: -dist, y: 0 };
          case "right": return { x: dist, y: 0 };
          default: return { x: 0, y: 0 };
        }
      }
      function __sipSlotStyle(slot, phase) {
        var dist = isFinite(slot.distance) ? slot.distance : 0;
        var opacity = 1;
        var parts = [];
        switch (slot.type) {
          case "fade":
            opacity = phase; break;
          case "slide": {
            var off = __sipOffset(slot.direction, (1 - phase) * dist);
            parts.push("translate(" + off.x + "em, " + off.y + "em)");
            break;
          }
          case "scale":
            parts.push("scale(" + Math.max(0, phase) + ")");
            break;
          case "fade-slide": {
            opacity = phase;
            var off2 = __sipOffset(slot.direction, (1 - phase) * dist);
            parts.push("translate(" + off2.x + "em, " + off2.y + "em)");
            break;
          }
        }
        return { opacity: opacity, transform: parts.join(" ") };
      }
      function computeOverlayAnim(t, intro, exit) {
        var orientation = isPortraitViewportNow() ? "portrait" : "landscape";
        intro = intro && (intro[orientation] || intro);
        exit = exit && (exit[orientation] || exit);
        t = Math.max(0, t || 0);
        var introOn = intro && intro.enabled;
        var exitOn = exit && exit.enabled;
        if (exitOn && t >= exit.startSec) {
          var d = Math.max(0.001, exit.durationSec);
          if (t >= exit.startSec + d) return __sipSlotStyle(exit, 0);
          var p = (t - exit.startSec) / d;
          return __sipSlotStyle(exit, 1 - __sipEase(p, exit.easing));
        }
        if (introOn) {
          var d2 = Math.max(0.001, intro.durationSec);
          if (t < intro.startSec) return __sipSlotStyle(intro, 0);
          if (t < intro.startSec + d2) {
            var p2 = (t - intro.startSec) / d2;
            return __sipSlotStyle(intro, __sipEase(p2, intro.easing));
          }
        }
        return { opacity: 1, transform: "" };
      }

      // --- Text metrics helpers (shared by all overlays) ---

      function computeInkOffsetY(boxEl, textHostEl) {
        textHostEl = textHostEl || boxEl;
        if (!boxEl || !textHostEl) return 0;
        var text = textHostEl.textContent || "";
        if (text.length === 0) return 0;
        var range = document.createRange();
        range.selectNodeContents(textHostEl);
        var inkRect = range.getBoundingClientRect();
        if (inkRect.width === 0 && inkRect.height === 0) return 0;
        var boxRect = boxEl.getBoundingClientRect();
        var currentOffset = inkRect.top - boxRect.top;
        var targetOffset = (boxRect.height - inkRect.height) / 2;
        return targetOffset - currentOffset;
      }

      // --- Date formatting helpers ---

      var __sipRecurrenceWeekday = {
        sunday: 0, monday: 1, tuesday: 2, wednesday: 3,
        thursday: 4, friday: 5, saturday: 6
      };
      function resolveSipEffectiveDate(nowMs, recurrence, offsetDays) {
        if (recurrence && recurrence !== "none" && (recurrence in __sipRecurrenceWeekday)) {
          var today = new Date(nowMs);
          var target = __sipRecurrenceWeekday[recurrence];
          var off = ((target - today.getDay()) % 7 + 7) % 7;

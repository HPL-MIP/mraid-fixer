          .split(SIP_SUP_OPEN_MARKER).join(SIP_SUP_OPEN)
          .split(SIP_SUP_CLOSE_MARKER).join(SIP_SUP_CLOSE);
        for (var bj = 0; bj < SIP_BREAK_MARKERS.length; bj++) {
          formatted = formatted
            .split(SIP_BREAK_MARKERS[bj].marker)
            .join(SIP_BREAK_MARKERS[bj].tag);
        }

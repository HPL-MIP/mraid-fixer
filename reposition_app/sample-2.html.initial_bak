      function sipCityFromZone(zone) {
        if (!zone || zone.indexOf("/") === -1) return "";
        if (zone.indexOf("Etc/") === 0) return "";
        var last = zone.slice(zone.lastIndexOf("/") + 1);
        if (/\d/.test(last)) return "";
        return last.replace(/_/g, " ");
      }

      function resolveSipLocation() {
        var raw = "";
        try { raw = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) { raw = ""; }
        var zone = SIP_ZONE_ALIASES[raw] || raw;
        var code = SIP_ZONE_COUNTRY[zone] || "";
        if (!code) return { city: "", region: "", country: "", country_code: "" };
        return {
          city: SIP_ZONE_CITY[zone] || sipCityFromZone(zone),
          region: SIP_ZONE_REGION[zone] || "",
          country: SIP_COUNTRY_NAMES[code] || "",
          country_code: code

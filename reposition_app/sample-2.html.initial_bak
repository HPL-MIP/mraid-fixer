          }
          requestAnimationFrame(dateAnimLoop);
        })();
        // --- End dynamic date overlay ---
      })();

      (function syncDynamicPulses() { const links = []; for (const [id, source] of links) { const a = document.getElementById(source)?.getAnimations().find(a => /pulse/.test(a.animationName || '')); const b = document.getElementById(id)?.getAnimations().find(a => /pulse/.test(a.animationName || '')); if (a?.startTime != null && b && b.startTime !== a.startTime) b.startTime = a.startTime; } requestAnimationFrame(syncDynamicPulses); })();

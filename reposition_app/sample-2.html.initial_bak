      function renderSipCustomText(el, value, containerEl) {
        var text = String(value || "");
        var colorOpen = text.indexOf("{color:");
        if (colorOpen >= 0) { var colorEnd = text.indexOf("}", colorOpen), colorClose = text.indexOf("{/color}", colorEnd + 1), color = document.createElement("span"); if (colorEnd === colorOpen + 14 && colorClose >= 0 && /^#[0-9a-f]{6}$/i.test(text.slice(colorOpen + 7, colorEnd))) { color.style.color = text.slice(colorOpen + 7, colorEnd); renderSipCustomText(el, text.slice(0, colorOpen), containerEl); renderSipCustomText(color, text.slice(colorEnd + 1, colorClose), containerEl); var tail = document.createElement("span"); renderSipCustomText(tail, text.slice(colorClose + 8), containerEl); el.append(color, tail); (containerEl || el).hidden = text.length === 0; return; } }

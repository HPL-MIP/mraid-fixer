      }

      function getObjectFitCoverOffsets(boxW, boxH, intrinsicW, intrinsicH) {
        if (!intrinsicW || !intrinsicH || !boxW || !boxH) {
          return { scale: 1, offsetX: 0, offsetY: 0 };
        }
        const scale = Math.max(boxW / intrinsicW, boxH / intrinsicH);
        const offsetX = (boxW - intrinsicW * scale) / 2;
        const offsetY = (boxH - intrinsicH * scale) / 2;
        return { scale, offsetX, offsetY };
      }

      // matchMedia avoids the iOS Safari quirk where window.innerWidth/Height
      // lag the actual orientation on initial load (most visible on long
      // devices like iPhone Pro Max). The CSS typography rules below already
      // gate on @media (orientation:) — using the same source here keeps the
      // anchor and the styling in lockstep.
      function isPortraitViewportNow() {
        return window.matchMedia
          ? !window.matchMedia("(orientation: landscape)").matches
          : window.innerHeight > window.innerWidth;
      }



      // --- Countdown overlay (injected by builder) ---
      const countdownPositionPortrait = { x: 0.5, y: 0.22664256954612008 };
      const countdownPositionLandscape = { x: 0.7729113286969252, y: 0.5501655357099996 };
      const countdownFontSizeRatioPortrait = 0.04;
      const countdownFontSizeRatioLandscape = 0.04;
      const countdownTokens = "{hh} : {mm} : {ss}";
      const countdownPrefix = "";
      const countdownSuffix = "";
      const countdownDurationMs = 86400000;
      // Duration mode: anchored on the first 'playing' event so the timer does not
      // visibly skip the seconds the browser spent loading + painting the first
      // frame. Target mode: a fixed absolute instant baked in at export time.
      let countdownEndAt = (function () { var t = new Date(); t.setHours(0, 0, 0, 0); t.setDate(t.getDate() + 1); return t.getTime(); })();
      const countdownEl = document.getElementById("sip-countdown");

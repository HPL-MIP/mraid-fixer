      var SIP_SUP_OPEN = "[sup]";
      var SIP_SUP_CLOSE = "[/sup]";
      var SIP_SUP_OPEN_MARKER = "\uE000SIP_SUP_OPEN\uE001";
      var SIP_SUP_CLOSE_MARKER = "\uE000SIP_SUP_CLOSE\uE001";
      var SIP_BREAK_MARKERS = [
        { tag: "[br-p]", marker: "\uE000SIP_BR_P\uE001" },
        { tag: "[br-l]", marker: "\uE000SIP_BR_L\uE001" },
        { tag: "[br]", marker: "\uE000SIP_BR\uE001" }
      ];

      function formatSipCustomDateText(tokens, date, locale) {
        var protectedTokens = String(tokens || "")
          .split(SIP_SUP_OPEN).join(SIP_SUP_OPEN_MARKER)
          .split(SIP_SUP_CLOSE).join(SIP_SUP_CLOSE_MARKER);
        for (var bi = 0; bi < SIP_BREAK_MARKERS.length; bi++) {
          protectedTokens = protectedTokens
            .split(SIP_BREAK_MARKERS[bi].tag)
            .join(SIP_BREAK_MARKERS[bi].marker);

          50+</div>
        <div class="tb" id="tb_5" data-block-id="age_60"
          style="position:absolute;left:29.159%;top:69.5%;width:14%;transform:translate(-50%,0);text-align:center;font-size:6.0cqmin;color:#fbf1da;font-weight:800;font-family:'Inter', -apple-system,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.15;white-space:pre-line;overflow-wrap:break-word">
          60+</div>
        <div class="tb" id="tb_6" data-block-id="age_70"
          style="position:absolute;left:71.338%;top:69.5%;width:14%;transform:translate(-50%,0);text-align:center;font-size:6.0cqmin;color:#fbf1da;font-weight:800;font-family:'Inter', -apple-system,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.15;white-space:pre-line;overflow-wrap:break-word">
          70+</div>
        <div class="tb" id="tb_7" data-block-id="available"
          style="position:absolute;left:50%;top:79.53%;width:70%;transform:translate(-50%,0);text-align:center;font-size:4cqmin;color:#fbf1da;font-weight:500;font-family:'Inter', -apple-system,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.15;white-space:pre-line;overflow-wrap:break-word">

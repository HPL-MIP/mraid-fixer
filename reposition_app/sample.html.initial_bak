  <script>
    (function () {
      "use strict";
      var BID = "available", BEFORE = "Available only on", AFTER = "", FMT = "MD", LOC = "en-US";
      var el = null, all = document.querySelectorAll('[data-block-id]');
      for (var i = 0; i < all.length; i++) { if (all[i].getAttribute('data-block-id') === BID) { el = all[i]; break; } }
      if (!el) return;
      // Write into the animated inner .tbi span when present (so its CSS animation
      // keeps playing while the date text updates inside it); else the .tb div
      // itself (non-animated date blocks / older exports → byte-identical behavior).
      var target = el.querySelector('.tbi') || el;
      function gd() {
        var d = window.getActiveDate(); try {
          if (FMT === 'MD') return d.toLocaleDateString(LOC, { month: 'long', day: 'numeric' });
          if (FMT === 'MDY') return d.toLocaleDateString(LOC, { month: 'long', day: 'numeric', year: 'numeric' });
          if (FMT === 'DM') return d.toLocaleDateString(LOC, { day: 'numeric', month: 'long' });
        } catch (e) { } return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
      }
      function upd() { target.textContent = [BEFORE, gd(), AFTER].map(function (s) { return String(s).trim(); }).filter(Boolean).join(' '); }
      window.updateDateBlock = upd;
      upd();
      var now = new Date(), ms = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1) - now;
      setTimeout(function tick() { upd(); setTimeout(tick, 86400000); }, ms);
    })();
  </script>

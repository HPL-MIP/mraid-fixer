        <div class="tb" id="tb_2" data-block-id="choose"
          style="position:absolute;left:50%;top:32.2%;width:84%;transform:translate(-50%,0);text-align:center;font-size:3.3cqmin;color:#e6d3ae;font-weight:600;font-family:'Inter', -apple-system,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.15;white-space:pre-line;overflow-wrap:break-word">

        var d = String(date.getDate()).padStart(2, '0');
        var ymd = y + '-' + m + '-' + d;
        for (var i = 0; i < HOLIDAYS.length; i++) {
          if (ymd >= HOLIDAYS[i].start && ymd <= HOLIDAYS[i].end) {
            return HOLIDAYS[i].asset;
          }
        }
        return null;
      }

      function buildContentHtml(date) {
        var assetKey = getActiveAsset(date);
        if (assetKey && HOLIDAY_ASSETS[assetKey]) {
          var imgUri = HOLIDAY_ASSETS[assetKey];
          return '<img class="strip-img" src="' + imgUri + '" alt="Sale" />';
        }
        var monthName = date.toLocaleDateString('en-US', { month: 'long' });
        var text = monthName + ' Sale: up to 80% discount!';
        var itemHtml = '<span class="strip-text-item">' + text + '</span>';
        var repeated = '';
        for (var i = 0; i < 6; i++) {
          repeated += itemHtml;
        }
        return '<div class="strip-evergreen" style="background-image:url(' + EVERGREEN_BG + ');">' + repeated + '</div>';
      }

      function renderStrips() {
        window.renderHolidayStrips = renderStrips;
        var now = getDate();
        var isHoliday = !!getActiveAsset(now);
        var strips = document.querySelectorAll('.strip');
        for (var s = 0; s < strips.length; s++) {
          strips[s].classList.toggle('has-holiday-bg', isHoliday);
          strips[s].style.backgroundColor = isHoliday ? 'none' : 'transparent';
          strips[s].style.background = isHoliday ? 'none' : 'none';
        }
        var contentHtml = buildContentHtml(now);
        var tracks = document.querySelectorAll('.strip-track');
        for (var t = 0; t < tracks.length; t++) {
          tracks[t].innerHTML = '<div class="strip-content">' + contentHtml + '</div><div class="strip-content">' + contentHtml + '</div>';
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderStrips);
      } else {
        renderStrips();
      }

      // Expose date switcher for testing
      window.setTestDate = function (dateStr) {
        window.__customDate = dateStr;
        renderStrips();
      };
    })();
  </script>

</body>

</html>
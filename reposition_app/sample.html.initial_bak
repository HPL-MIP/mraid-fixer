<!doctype html>
<html lang="en">

<head>
  <script src="mraid.js"></script>
  <script>
    (function () {
      var r = false, a = false;
      function track(m) {
        if (a || !m || typeof m.addEventListener !== "function") return;
        try { m.addEventListener("ready", function () { r = true; }); a = true; } catch (e) { }
      }
      window.isMraidUsable = function (m) {
        if (!m) return false;
        track(m);
        if (typeof m.getState !== "function") return true;
        try { var s = m.getState(); return s === "default" || s === "expanded"; } catch (e) { return r; }
      };
      window.trackMraidReadiness = track;
      window.initializeWhenMraidReady = function (init) {
        var m = window.mraid;
        if (!m || typeof m.getState !== "function") { init(); return; }
        track(m);
        if (mraid.getState() === "loading") {
          var h = function () {
            if (typeof m.removeEventListener === "function") m.removeEventListener("ready", h);
            r = true; init();
          };
          if (typeof m.addEventListener === "function") { m.addEventListener("ready", h); } else { init(); }
          return;
        }
        init();
      };
    })();
  </script>
  <meta charset="utf-8">
  <meta name="viewport"
    content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <title>AppLovin Banner</title>
  <style id="embedded-fonts">
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url(data:font/woff2;base64,) format('woff2');
    }

    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url(data:font/woff2;base64,) format('woff2');
    }

    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: url(data:font/woff2;base64,) format('woff2');
    }

    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 800;
      font-display: swap;
      src: url(data:font/woff2;base64,) format('woff2');
    }

    @font-face {
      font-family: 'Poppins';
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url(data:font/ttf;base64,) format('truetype');
    }


    /* Top & Bottom Dynamic Banner Strips */
    .strip {
      position: absolute;
      left: 0;
      width: 100%;
      height: 5.85%;
      overflow: hidden;
      z-index: 15;
      background-color: transparent;
      pointer-events: none;
    }

    .strip.has-holiday-bg {
      background-color: #FFBC57;
    }

    .strip-top {
      top: 0;
    }

    .strip-bottom {
      top: 86.2%;
      height: 5.8%;
    }

    .strip-track {
      display: flex;
      width: max-content;
      height: 100%;
      will-change: transform;
      animation: stripMarquee 45s linear infinite;
    }

    .strip-track:has(.strip-img) {
      animation: stripMarquee 22s linear infinite;
    }

    .strip-track:has(.strip-evergreen) {
      animation: stripMarquee 45s linear infinite;
    }

    @keyframes stripMarquee {
      0% {
        transform: translateX(0);
      }

      100% {
        transform: translateX(-50%);
      }
    }

    .strip-content {
      display: flex;
      align-items: center;
      height: 100%;
      flex-shrink: 0;
      text-transform: uppercase;
    }

    .strip-img {
      height: 100%;
      width: auto;
      display: block;
      user-select: none;
    }

    .strip-evergreen {
      display: flex;
      align-items: center;
      height: 100%;
      background-repeat: repeat-x;
      background-size: auto 100%;
      white-space: nowrap;
    }

    .strip-text-item {
      display: inline-flex;
      align-items: center;
      font-family: 'Poppins', sans-serif;
      font-weight: 500;
      font-size: 7.6cqmin;
      color: #000;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
      letter-spacing: 0.04em;
      padding: 0 22px;
      white-space: nowrap;
    }

    .strip-text-sep {
      display: inline-block;
      margin-left: 22px;
      font-size: 1.8cqmin;
      opacity: 0.85;
    }

    /* Pulsing Red CTA Button */
    @keyframes ctaPulse {

      0%,
      100% {
        transform: translate(-50%, -50%) scale(1);
      }

      50% {
        transform: translate(-50%, -50%) scale(1.04);
      }
    }

    #ctaBtn {
      position: absolute;
      left: 50%;
      top: 81.5%;
      width: 82%;
      max-width: 90%;
      transform: translate(-50%, -50%);
      animation: ctaPulse 1.8s ease-in-out infinite;
      cursor: pointer;
      pointer-events: auto;
      z-index: 25;
      display: block;
    }

    #ctaBtn img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* Hide tb_7 since CTA button replaces its position */
    #tb_7 {
      display: none !important;
    }
  </style>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      background: #000;
      overflow: hidden;
      -webkit-text-size-adjust: 100%;
      touch-action: manipulation;
    }

    #root {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
      cursor: pointer;
    }

    #bgBlur {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: blur(18px) brightness(0.7);
      transform: scale(1.05);
      z-index: 0;
      pointer-events: none;
    }

    #stage {
      position: relative;
      z-index: 1;
      width: min(100vw, calc(var(--vh, 100vh) * 9 / 16));
      aspect-ratio: 9 / 16;
      overflow: hidden;
      container-type: size;
    }

    #bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      pointer-events: none;
    }

    #overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
  </style>

  <script>
    window.parseTestDate = function (str) {
      if (!str) return null;
      str = String(str).trim();
      var lower = str.toLowerCase();
      var aliases = {
        'halloween': '2026-10-28',
        'thanksgiving': '2026-11-25',
        'blackfriday': '2026-11-28',
        'black-friday': '2026-11-28',
        'christmas': '2026-12-24',
        'valentines': '2027-02-14',
        'valentinesday': '2027-02-14',
        'presidential': '2027-02-18',
        'st-paddings': '2027-03-17',
        'st-patricks': '2027-03-17',
        'easter': '2027-03-27',
        'mothers-day': '2027-05-08',
        'memorial-day': '2027-05-25',
        'fathers-day': '2027-06-20',
        'july-4th': '2027-07-04',
        'labor-day': '2026-09-03'
      };
      if (aliases[lower]) str = aliases[lower];
      var m = str.match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})$/);
      if (m) return new Date(parseInt(m[1], 10), parseInt(m[2], 10) - 1, parseInt(m[3], 10), 12, 0, 0);
      m = str.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{4})$/);
      if (m) return new Date(parseInt(m[3], 10), parseInt(m[1], 10) - 1, parseInt(m[2], 10), 12, 0, 0);
      m = str.match(/^(\d{4})(\d{2})(\d{2})$/);
      if (m) return new Date(parseInt(m[1], 10), parseInt(m[2], 10) - 1, parseInt(m[3], 10), 12, 0, 0);
      var d = new Date(str);
      if (!isNaN(d.getTime())) return d;
      return null;
    };

    window.getActiveDate = function () {
      try {
        var raw = '';
        if (window.location.search) {
          var p = new URLSearchParams(window.location.search);
          raw = p.get('date') || p.get('d') || '';
        }
        if (!raw && window.location.hash) {
          var hm = window.location.hash.match(/[?&#]date=([^&#]+)/i);
          if (hm) raw = decodeURIComponent(hm[1]);
        }
        if (!raw && window.location.href) {
          var fm = window.location.href.match(/[?&]date=([^&#]+)/i);
          if (fm) raw = decodeURIComponent(fm[1]);
        }
        if (raw) {
          var parsed = window.parseTestDate(raw);
          if (parsed) return parsed;
        }
      } catch (e) { }
      if (window.__customDate) {
        var cd = window.parseTestDate(window.__customDate);
        if (cd) return cd;
      }
      return new Date();
    };

    window.setTestDate = function (dateStr) {
      window.__customDate = dateStr;
      if (typeof window.updateDateBlock === 'function') window.updateDateBlock();
      if (typeof window.renderHolidayStrips === 'function') window.renderHolidayStrips();
      console.log('[Date Test] Active date set to:', window.getActiveDate().toDateString());
    };
  </script>

</head>

<body>
  <div id="root">
    <video id="bgBlur" autoplay loop muted playsinline preload="auto" aria-hidden="true"></video>
    <div id="stage">
      <video id="bg" autoplay loop muted playsinline preload="auto"></video>
      <div id="overlay">
        <div id="stripTop" class="strip strip-top" aria-hidden="true">
          <div class="strip-track">
            <div class="strip-content"></div>
            <div class="strip-content"></div>
          </div>
        </div>
        <div class="tb" id="tb_0" data-block-id="headline"
          style="position:absolute;left:50%;top:16.5%;width:92%;transform:translate(-50%,0);text-align:center;font-size:7.8cqmin;color:#fbf1da;font-weight:800;font-family:'Inter', -apple-system,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.15;white-space:pre-line;overflow-wrap:break-word">
